# Presence (live visitor count)
#
# These power the "N here now" badge. Leave them unset and the badge simply
# does not render — no placeholder number is ever shown.
#
# The presence payload contains only a random per-tab session id and the
# current route. No IP addresses, device fingerprints or personal data are
# collected or stored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL, used for canonical tags and the generated sitemap.
VITE_SITE_URL=https://nmesirionye.ngbaronye.com